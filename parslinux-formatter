#!/usr/bin/python3
"""ParsLinux Formatter - Ana Başlatıcı Betiği.

Sistemde GTK4 ve Libadwaita mevcutsa modern arayüzü (parslinux-formatter-gtk4),
aksi takdirde klasik GTK3 arayüzünü (MainWindow) başlatır.
"""

import os
import sys

# Kurulum dizinini ve yerel kaynak dizinini kontrol et
app_dir = os.path.dirname(os.path.abspath(__file__))
installed_dir = "/usr/share/parslinux/parslinux-formatter/src"

if os.path.isdir(os.path.join(app_dir, "src")):
    sys.path.insert(0, os.path.join(app_dir, "src"))
elif os.path.isdir(installed_dir):
    sys.path.insert(0, installed_dir)

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from ModernWindow import Application as Gtk4App
    app = Gtk4App()
    sys.exit(app.run(sys.argv))
except Exception:
    import gi
    gi.require_version("Gtk", "3.0")
    from Main import app as gtk3_app
    sys.exit(gtk3_app.run(sys.argv))
