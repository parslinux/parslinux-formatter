<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>

  <vendor>ParsLinux Developers</vendor>
  <vendor_url>https://pars.org.tr/</vendor_url>

  <action id="tr.org.parslinux.pkexec.parslinux-formatter">
    <description>Run ParsLinux Formatter</description>
    <description xml:lang="tr">ParsLinux Biçimlendiriciyi Çalıştır</description>
    <message>Authentication is required to format USB storage devices</message>
    <message xml:lang="tr">USB depolama aygıtlarını biçimlendirmek için yönetici yetkisi gerekiyor</message>
    <icon_name>parslinux-formatter</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/parslinux/parslinux-formatter/src/USBFormatter.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
