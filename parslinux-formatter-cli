#!/usr/bin/python3
"""ParsLinux Formatter - Bağımsız Başsız (Headless) Komut Satırı Başlatıcısı."""

import os
import sys

app_dir = os.path.dirname(os.path.abspath(__file__))
installed_dir = "/usr/share/parslinux/parslinux-formatter/src"

if os.path.isdir(os.path.join(app_dir, "src")):
    sys.path.insert(0, os.path.join(app_dir, "src"))
elif os.path.isdir(installed_dir):
    sys.path.insert(0, installed_dir)

import CLI

if __name__ == "__main__":
    CLI.main()
